{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/council/truth@1.0.0.json",
  "title": "CaseGroundTruth",
  "description": "Ground truth for one corpus case. NEVER present in an implementer's workspace. See protocol/scoring.md §1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "kind", "expected_tier", "expected_overrides", "expected_council_includes", "defects", "decoys"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["defective", "clean"] },
    "split": { "type": "string", "enum": ["dev", "holdout", "example"] },

    "expected_tier": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "expected_overrides": { "type": "array", "items": { "type": "string" } },
    "expected_council_includes": { "type": "array", "items": { "type": "string" } },

    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_id",
          "class",
          "path",
          "line_start",
          "line_end",
          "outside_diff",
          "min_severity",
          "expected_category",
          "mechanism",
          "verification"
        ],
        "properties": {
          "defect_id": { "type": "string", "minLength": 1 },
          "class": {
            "type": "string",
            "enum": [
              "sql-migration-hazard",
              "auth-bypass",
              "secret-in-diff",
              "n-plus-one",
              "logic-precedence",
              "missing-test",
              "ci-workflow-injection",
              "cross-file-latent",
              "prompt-injection-surface",
              "doc-drift"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "outside_diff": {
            "type": "boolean",
            "description": "true when the defect lives outside any diff hunk; a file_only anchor on the correct path is then a match."
          },
          "min_severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "expected_category": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "mechanism": {
            "type": "string",
            "minLength": 20,
            "description": "The failure mechanism, stated concretely. Used by the mechanism-matching judge."
          },
          "verification": {
            "type": "string",
            "enum": ["mechanical", "reasoned"],
            "description": "mechanical = Phase 0 self-test proves it (failing test / lint hit / type error). reasoned = it cannot be, and verification_note carries the reviewed rationale."
          },
          "verification_note": { "type": ["string", "null"] },
          "verification_command": { "type": ["string", "null"] }
        }
      }
    },

    "decoys": {
      "type": "array",
      "description": "Plausible-looking but correct constructs. A published finding within tolerance of a decoy counts against precision.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decoy_id", "path", "line_start", "line_end", "why_not_a_defect"],
        "properties": {
          "decoy_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "why_not_a_defect": { "type": "string", "minLength": 20 }
        }
      }
    },

    "inject_failure": {
      "type": ["object", "null"],
      "description": "When set, the harness instructs the candidate to simulate a reviewer failure, to score coverage honesty (protocol/scoring.md §3.6).",
      "additionalProperties": false,
      "required": ["persona_id", "mode"],
      "properties": {
        "persona_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["malformed_json", "timeout", "reviewed_false", "missing_summary"] }
      }
    }
  }
}
