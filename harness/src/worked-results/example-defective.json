  "findings": [
    {
      "id": "f-3a91c07e",
      "title": "Session cache keyed on an 8-character token prefix bypasses signature verification",
      "severity": "P0",
      "category": "security",
      "confidence": "high",
      "status": "open",
      "details": "verifySession returns a cached identity on any token whose first 8 characters match a previously-seen token, before the signature check runs. Attacker model: any caller who observes or guesses an 8-character prefix of a live session token can present `<prefix>.anything` and receive the cached userId and tenantId of the legitimate holder. The cache is process-global with no expiry, so one poisoned entry persists for the process lifetime and crosses tenants. This defeats the AGENTS.md invariant that every order read is tenant-scoped, because tenantId itself becomes attacker-selectable.",
      "evidence": [
        {
          "path": "src/auth.ts",
          "line": 20,
          "side": "RIGHT",
          "start_line": 19,
          "start_side": "RIGHT",
          "symbol": "verifySession",
          "anchor_status": "current_diff"
        }
      ],
      "published": true,
      "publication_surface": "inline",
      "suppression_reason": null,
